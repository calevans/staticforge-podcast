{
    "name": "calevans/staticforge-podcast",
    "description": "StaticForge Feature: Podcast",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Cal Evans",
            "email": "cal@calevans.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "eicc/staticforge": "^3.0",
        "james-heinrich/getid3": "^1.9",
        "symfony/console": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "shipmonk/dead-code-detector": "^0.13.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Calevans\\StaticForgePodcast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calevans\\StaticForgePodcast\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "eicc/staticforge-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "staticforge": {
            "feature": "Calevans\\StaticForgePodcast\\Feature"
        }
    }
}
