includes:
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon
  - vendor/shipmonk/dead-code-detector/rules.neon

parameters:
  level: 8
  phpVersion: 80500
  paths:
    - src
    - tests
  treatPhpDocTypesAsCertain: false

  ignoreErrors:
    # Feature event handlers are dispatched at runtime by EventManager via the
    # #[EventListener] attribute, and the Feature itself is constructed via
    # FeatureFactory's reflection-based newInstanceArgs(), so the dead-code
    # detector cannot see either kind of call.
    - message: '#Unused Calevans\\StaticForgePodcast\\Feature::(__construct|registerCommands|handleCreate|handlePreLoop|handlePreRender|handleMarkdownConverted|handleRssBuilderInit|handleRssItemBuilding|handlePostLoop|handleDestroy)#'
      identifier: shipmonk.deadMethod
